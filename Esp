repeat task.wait() until game:IsLoaded()

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")

local LP = Players.LocalPlayer

local function forceNiceLight()
	Lighting.ClockTime = 13
	Lighting.Brightness = 2
	Lighting.GlobalShadows = false
	Lighting.FogEnd = 1e10
	Lighting.Ambient = Color3.fromRGB(185,185,185)
	Lighting.OutdoorAmbient = Color3.fromRGB(200,200,200)
end

forceNiceLight()

Lighting:GetPropertyChangedSignal("ClockTime"):Connect(forceNiceLight)
Lighting:GetPropertyChangedSignal("Brightness"):Connect(forceNiceLight)

for _,v in pairs(Lighting:GetChildren()) do
	if v:IsA("Sky")
	or v:IsA("Atmosphere")
	or v:IsA("BloomEffect")
	or v:IsA("BlurEffect")
	or v:IsA("SunRaysEffect")
	or v:IsA("DepthOfFieldEffect") then
		v:Destroy()
	end
end

for _,obj in pairs(workspace:GetDescendants()) do
	if obj:IsA("BasePart") then
		obj.CastShadow = false
	end
end

local function removeIfTexture(obj)
	if obj:IsA("Texture")
	or obj:IsA("Decal")
	or obj:IsA("SurfaceAppearance") then
		obj:Destroy()
	end
end

for _,obj in pairs(workspace:GetDescendants()) do
	removeIfTexture(obj)
end

workspace.DescendantAdded:Connect(removeIfTexture)

local function makeCrosshair()
	local gui = LP.PlayerGui:FindFirstChild("PERMA_CROSSHAIR")
	
	if not gui then
		gui = Instance.new("ScreenGui")
		gui.Name = "PERMA_CROSSHAIR"
		gui.IgnoreGuiInset = true
		gui.ResetOnSpawn = false
		gui.DisplayOrder = 9999999
		gui.Parent = LP.PlayerGui
	end
	
	if not gui:FindFirstChild("DOT") then
		
		local dot = Instance.new("Frame")
		dot.Name = "DOT"
		dot.AnchorPoint = Vector2.new(0.5,0.5)
		dot.Position = UDim2.new(0.5,0,0.5,0)
		dot.Size = UDim2.new(0,5,0,5)
		dot.BackgroundColor3 = Color3.new(1,1,1)
		dot.BorderSizePixel = 0
		dot.Parent = gui
		
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(1,0)
		corner.Parent = dot
		
		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 1
		stroke.Color = Color3.new(0,0,0)
		stroke.Parent = dot
	end
end

makeCrosshair()

task.spawn(function()
	while true do
		task.wait(1)
		if not LP.PlayerGui:FindFirstChild("PERMA_CROSSHAIR") then
			makeCrosshair()
		end
	end
end)

local function createMyHitbox(char)
	local hrp = char:WaitForChild("HumanoidRootPart",10)
	if not hrp then return end
	
	if hrp:FindFirstChild("MY_HITBOX") then return end
	
	local box = Instance.new("SelectionBox")
	box.Name = "MY_HITBOX"
	box.Adornee = hrp
	box.LineThickness = 0.03
	box.Color3 = Color3.fromRGB(255,215,0)
	box.Transparency = 0.35
	box.Parent = hrp
end

if LP.Character then
	createMyHitbox(LP.Character)
end

LP.CharacterAdded:Connect(function(char)
	task.wait(1)
	createMyHitbox(char)
	makeCrosshair()
end)

local function createESP(player)
	if player == LP then return end
	
	local function setup(char)
		local hrp = char:WaitForChild("HumanoidRootPart",10)
		if not hrp then return end
		
		if char:FindFirstChild("ESP_HL") then return end
		
		local hl = Instance.new("Highlight")
		hl.Name = "ESP_HL"
		hl.FillTransparency = 0.9
		hl.OutlineTransparency = 1
		hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		hl.Parent = char
		
		local bill = Instance.new("BillboardGui")
		bill.Size = UDim2.new(0,65,0,13)
		bill.StudsOffset = Vector3.new(0,2.2,0)
		bill.AlwaysOnTop = true
		bill.MaxDistance = 1000
		bill.Parent = hrp
		
		local text = Instance.new("TextLabel")
		text.BackgroundTransparency = 1
		text.Size = UDim2.new(1,0,1,0)
		text.Font = Enum.Font.GothamBold
		text.TextSize = 8
		text.TextStrokeTransparency = 0.85
		text.Parent = bill
		
		RunService.RenderStepped:Connect(function()
			if not hrp.Parent then return end
			
			local myChar = LP.Character
			if not myChar then return end
			
			local myHRP = myChar:FindFirstChild("HumanoidRootPart")
			if not myHRP then return end
			
			local dist = math.floor((myHRP.Position - hrp.Position).Magnitude)
			local color = player.Team and player.TeamColor.Color or Color3.new(1,1,1)
			
			hl.FillColor = color
			text.TextColor3 = color
			text.Text = player.Name.." | "..dist.."m"
		end)
	end
	
	if player.Character then
		setup(player.Character)
	end
	
	player.CharacterAdded:Connect(setup)
end

for _,p in pairs(Players:GetPlayers()) do
	createESP(p)
end

Players.PlayerAdded:Connect(createESP)
