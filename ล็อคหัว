local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local camera = Workspace.CurrentCamera

math.randomseed(tick())

local Config = {
    Enabled = true,
    OnlyWhenHoldRight = false,
    FOV = 50,
    MaxDistance = 200,
    Smoothness = 10,

    AimBones = {
        {Name = "Head", Weight = 45},
        {Name = "UpperTorso", Weight = 35},
        {Name = "HumanoidRootPart", Weight = 20},
    },

    BoneChangeDelay = {0.35, 0.65},

    ESP = {
        Enabled = true,
        ShowBox = true,
        ShowName = true,
        ShowDistance = true,
        Color = Color3.fromRGB(255, 255, 255),
        Transparency = 0.4,
    }
}

local holdingRight = false
UserInputService.InputBegan:Connect(function(i,g)
    if i.UserInputType == Enum.UserInputType.MouseButton2 then
        holdingRight = true
    end
end)
UserInputService.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton2 then
        holdingRight = false
    end
end)

local function getRandomBone()
    local total = 0
    for _,b in ipairs(Config.AimBones) do
        total += b.Weight
    end
    local roll = math.random() * total
    local acc = 0
    for _,b in ipairs(Config.AimBones) do
        acc += b.Weight
        if roll <= acc then
            return b.Name
        end
    end
    return "Head"
end

local currentBone = "Head"
local nextBoneChange = 0

local function angleBetween(a,b)
    local na, nb = a.Unit, b.Unit
    local d = math.clamp(na:Dot(nb), -1, 1)
    return math.deg(math.acos(d))
end

local function getTargets()
    local t = {}
    for _,p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local h = p.Character:FindFirstChild("Humanoid")
            if h and h.Health > 0 then
                table.insert(t, p.Character)
            end
        end
    end
    return t
end

local function chooseTarget()
    local camPos = camera.CFrame.Position
    local camLook = camera.CFrame.LookVector
    local best, bestScore

    for _,char in ipairs(getTargets()) do
        local part = char:FindFirstChild(currentBone)
        if part then
            local dir = part.Position - camPos
            local dist = dir.Magnitude
            if dist <= Config.MaxDistance then
                local ang = angleBetween(camLook, dir)
                if ang <= Config.FOV/2 then
                    local rayParams = RaycastParams.new()
                    rayParams.FilterType = Enum.RaycastFilterType.Blacklist
                    rayParams.FilterDescendantsInstances = {player.Character}
                    local ray = Workspace:Raycast(camPos, dir, rayParams)
                    if not ray or ray.Instance:IsDescendantOf(char) then
                        local score = ang + dist/15
                        if not bestScore or score < bestScore then
                            bestScore = score
                            best = part.Position
                        end
                    end
                end
            end
        end
    end
    return best
end

local function smoothLook(dt, pos)
    local camPos = camera.CFrame.Position
    local look = camera.CFrame.LookVector
    local desired = (pos - camPos).Unit
    local t = 1 - math.exp(-Config.Smoothness * dt)
    camera.CFrame = CFrame.new(camPos, camPos + look:Lerp(desired, t))
end

local ESPFolder = Instance.new("Folder", player:WaitForChild("PlayerGui"))
ESPFolder.Name = "ESP"

local function clearESP()
    for _,v in ipairs(ESPFolder:GetChildren()) do
        v:Destroy()
    end
end

local function createESP(char)
    local box = Instance.new("BoxHandleAdornment")
    box.Adornee = char
    box.Size = char:GetExtentsSize()
    box.Color3 = Config.ESP.Color
    box.Transparency = Config.ESP.Transparency
    box.AlwaysOnTop = true
    box.ZIndex = 2
    box.Parent = ESPFolder

    local billboard = Instance.new("BillboardGui")
    billboard.Adornee = char:FindFirstChild("Head")
    billboard.Size = UDim2.new(0,200,0,40)
    billboard.StudsOffset = Vector3.new(0,2,0)
    billboard.AlwaysOnTop = true
    billboard.Parent = ESPFolder

    local label = Instance.new("TextLabel", billboard)
    label.Size = UDim2.new(1,0,1,0)
    label.BackgroundTransparency = 1
    label.TextColor3 = Config.ESP.Color
    label.TextScaled = true
    label.Font = Enum.Font.Gotham

    return function()
        if char and char.Parent then
            local dist = (camera.CFrame.Position - char.PrimaryPart.Position).Magnitude
            label.Text =
                (Config.ESP.ShowName and char.Name or "") ..
                (Config.ESP.ShowDistance and (" ["..math.floor(dist).."]") or "")
        else
            box:Destroy()
            billboard:Destroy()
        end
    end
end

local espUpdaters = {}

RunService.RenderStepped:Connect(function(dt)
    if tick() > nextBoneChange then
        currentBone = getRandomBone()
        nextBoneChange = tick() + math.random() *
            (Config.BoneChangeDelay[2] - Config.BoneChangeDelay[1]) +
            Config.BoneChangeDelay[1]
    end

    if Config.Enabled and (not Config.OnlyWhenHoldRight or holdingRight) then
        local pos = chooseTarget()
        if pos then
            smoothLook(dt, pos)
        end
    end

    if Config.ESP.Enabled then
        clearESP()
        espUpdaters = {}
        for _,char in ipairs(getTargets()) do
            if char.PrimaryPart then
                table.insert(espUpdaters, createESP(char))
            end
        end
    end

    for _,u in ipairs(espUpdaters) do
        u()
    end
end)
