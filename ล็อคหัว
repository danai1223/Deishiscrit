local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local camera = Workspace.CurrentCamera

local Config = {
    Enabled = true,
    FOV = 100,
    MaxDistance = 200,
    Smoothness = 100,
    OnlyWhenHoldRight = false,
}

-- ส่วนสุ่มตำแหน่งเล็ง
local AimParts = {
    "Head","Head","Head",
    "UpperTorso",
    "HumanoidRootPart"
}

local currentPart = "Head"
local lastRandom = 0
local randomDelay = 0.5

local function getRandomPart()
    currentPart = AimParts[math.random(1,#AimParts)]
end

-- เช็คว่ามีกำแพงบังไหม
local function isVisible(part)
    local camPos = camera.CFrame.Position
    local direction = part.Position - camPos

    local rayParams = RaycastParams.new()
    rayParams.FilterDescendantsInstances = {player.Character}
    rayParams.FilterType = Enum.RaycastFilterType.Blacklist
    rayParams.IgnoreWater = true

    local result = workspace:Raycast(camPos,direction,rayParams)

    if result then
        if result.Instance:IsDescendantOf(part.Parent) then
            return true
        else
            return false
        end
    end

    return true
end

local function getTargets()
    local list = {}

    for _,p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character and p.Character:FindFirstChild("Humanoid") then
            if p.Character.Humanoid.Health > 0 then
                table.insert(list,p.Character)
            end
        end
    end

    return list
end

local function angleBetween(a,b)
    local na = a.Unit
    local nb = b.Unit
    local dot = math.clamp(na:Dot(nb),-1,1)
    return math.deg(math.acos(dot))
end

local function chooseTarget()

    local camPos = camera.CFrame.Position
    local camLook = camera.CFrame.LookVector

    local best
    local bestScore = math.huge

    for _,char in ipairs(getTargets()) do

        local part = char:FindFirstChild(currentPart)

        if part and isVisible(part) then

            local dir = part.Position - camPos
            local dist = dir.Magnitude

            if dist <= Config.MaxDistance then

                local ang = angleBetween(camLook,dir)

                if ang <= (Config.FOV/2) then

                    local score = ang + (dist/10)

                    if score < bestScore then
                        bestScore = score
                        best = part.Position
                    end

                end
            end
        end
    end

    return best
end

local function smoothLook(dt,pos)

    local camPos = camera.CFrame.Position
    local currentLook = camera.CFrame.LookVector
    local desiredLook = (pos - camPos).Unit

    local t = 1 - math.exp(-Config.Smoothness * dt)

    local newLook = currentLook:Lerp(desiredLook,t)

    camera.CFrame = CFrame.new(camPos,camPos + newLook)
end

local holdingRight = false

UserInputService.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        holdingRight = true
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        holdingRight = false
    end
end)

local last = tick()

RunService:BindToRenderStep("AimAssist",Enum.RenderPriority.Camera.Value+1,function()

    local now = tick()
    local dt = now-last
    last = now

    if not Config.Enabled then return end
    if Config.OnlyWhenHoldRight and not holdingRight then return end

    -- สุ่มตำแหน่งเล็งทุก 0.5 วิ
    if now - lastRandom > randomDelay then
        lastRandom = now
        getRandomPart()
    end

    local target = chooseTarget()

    if target then
        smoothLook(dt,target)
    end

end)
